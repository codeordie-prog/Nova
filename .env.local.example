# =============================================================================
# Local infrastructure overlay.
#
# Copy to `.env.local` at the repo root. It is loaded BEFORE `.env` and wins on
# any key it sets, so this file only needs the handful of variables that point
# at infrastructure. API keys, model chains and everything else keep coming
# from your existing `.env`, which stays untouched.
#
# Delete or rename `.env.local` to go back to Redis Cloud and Cloud SQL.
#
#   ./dermascan/scripts/local_stack.sh up
# =============================================================================

# --- Redis -------------------------------------------------------------------
# No auth on the local instance; the URL has no credentials by design.
REDIS_URL=redis://127.0.0.1:6379/0

# The MedGemma gateway reads components rather than the URL.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# TEST_MODE swaps REDIS_URL for the shared cloud test instance and the test
# Telegram bot token. That is the opposite of what a local stack is for.
TEST_MODE=false

# --- Postgres ----------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=qutis_db
POSTGRES_USER=postgres
# db.py refuses to build a conninfo without a password even when the server
# trusts local connections, so this must be non-empty either way.
POSTGRESS_PASSWORD=localdev
# Empty: no TLS on a loopback connection. Must be blank, not `require`.
POSTGRES_SSLMODE=

# --- Billing -----------------------------------------------------------------
# Local Postgres is disposable, so enforcement can be on without risking a real
# balance. Meter must be on for enforce to validate.
BILLING_ENABLED=true
BILLING_METER_ENABLED=true
BILLING_ENFORCE=true

# Paystack test key. Checkout links resolve; the source-IP allowlist is skipped
# for sk_test_ keys so an ngrok tunnel or a curl replay can reach the webhook.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:8088/billing/return

# --- Observability -----------------------------------------------------------
# The shared LangSmith tenant is over its monthly trace limit and every local
# run burns quota the whole team shares.
LANGSMITH_TRACING=false
LANGSMITH_PIPELINE_TRACING=false

# --- Tracing ------------------------------------------------------------------
# Every process that loads this file appends here, so one end-to-end run reads
# as a single chronological trace. Each line carries process, pid and thread.
LOG_FILE=logs/local-run.log

LOG_LEVEL=INFO
