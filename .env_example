# --- Knowledge worker (not started by do_work.py) ----------------------------

KNOWLEDGE_PROVIDER=
KNOWLEDGE_JOB_STREAM=
KNOWLEDGE_DLQ_STREAM=
KNOWLEDGE_CONSUMER_GROUP=
KNOWLEDGE_CONSUMER_NAME=
KNOWLEDGE_RESEARCH_MAX_ATTEMPTS=
