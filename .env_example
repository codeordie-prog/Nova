# =============================================================================
# Dermascan Agents — environment variables
# Copy this file to `.env` at the repository root and fill in values.
# =============================================================================

# --- Core --------------------------------------------------------------------

REDIS_URL=

# Optional: set on servers when the process cwd is not the repo root.
# Relative paths below are resolved against this directory (must contain pyproject.toml).
DERMASCAN_ROOT=

# --- Qwen (primary orchestrator LLM) -----------------------------------------
# Deploy: poetry run python dermascan/scripts/deploy_qwen_app.py
# Point QWEN_BASE_URL at the Modal vLLM OpenAI-compatible endpoint (/v1).

QWEN_BASE_URL=
QWEN_OPENAI_BASE_URL=
QWEN_SERVED_MODEL_NAME=
QWEN_MODEL_NAME=
QWEN_API_KEY=
QWEN_OPENAI_API_KEY=
QWEN_TEMPERATURE=
QWEN_MAX_TOKENS=
QWEN_REQUEST_TIMEOUT_S=
QWEN_MAX_MODEL_LEN=
QWEN_ENABLE_THINKING=

# --- Orchestrator fallbacks (used when Qwen is unavailable) ------------------

OPENAI_API_KEY_QUTIS=
OPENAI_REQUEST_TIMEOUT_S=
GEMINI_API_KEY_QUTIS=
# Repo-relative path (recommended) or absolute path on the host/container.
GOOGLE_APPLICATION_CREDENTIALS_QUTIS=dermascan/backend/services/agents/configurations/qutisai-01221e9627c1.json
GOOGLE_CLOUD_PROJECT_QUTIS=
GOOGLE_CLOUD_LOCATION=

# --- PostgreSQL (required for rules engine / product safety flows) -----------
# The rules engine queries ingredient safety data from Postgres (CIR tables).
# Product-review and skin-review signal enrichment will fail without these.

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRESS_PASSWORD=
POSTGRES_TABLE=

# --- Rules engine & vector store ---------------------------------------------

RULES_ENGINE_INGREDIENT_CACHE_PREFIX=
PINECONE_API_KEY_QUTIS=
OPENAI_API_KEY_QUTIS=

# --- Research / search tools -------------------------------------------------

TAVILY_API_KEY_QUTIS=
TAVILY_API_KEY=

# --- Product / skin signal subagent models -----------------------------------

PRODUCT_INGREDIENT_MODEL=
PRODUCT_REPORT_MODEL=
SKIN_REVIEW_MODEL=
GROUP_REPORT_MODEL=
GROUP_REPORT_TTL_S=

# --- Backend API & ingress security ------------------------------------------

INTERNAL_API_SECRET=
WHATSAPP_INGRESS_SECRET=

# --- Telegram ----------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_LOCAL_WEBHOOK_URL=
TELEGRAM_HTTP_TIMEOUT_S=
TELEGRAM_TLS_VERIFY=
TELEGRAM_CA_BUNDLE=
TELEGRAM_POLL_TIMEOUT_S=
TELEGRAM_POLL_LIMIT=
TELEGRAM_RETRY_DELAY_S=
TELEGRAM_MEDIA_GROUP_WINDOW_S=
TELEGRAM_MEDIA_GROUP_MAX_WAIT_S=

# --- WhatsApp (outbound + media fetch via qutis sidecar) ---------------------

WHATSAPP_API_BASE_URL=
WHATSAPP_API_SEND_PATH=
WHATSAPP_MEDIA_PATH=
WHATSAPP_HTTP_TIMEOUT_S=
WHATSAPP_MEDIA_HTTP_TIMEOUT_S=
WHATSAPP_TLS_VERIFY=
WHATSAPP_CA_BUNDLE=
WHATSAPP_INTERNAL_API_SECRET=

# --- Firebase (media storage for Telegram / test uploads) --------------------
# Repo-relative path recommended. In Docker/K8s you can instead mount JSON at
# /run/secrets/firebase-sa.json and set CONFIG_FILE_PATH to that absolute path.

CONFIG_FILE_PATH=dermascan/backend/services/agents/configurations/dawagpn-1c9b72f24ea8.json
FIREBASE_STORAGE_BUCKET=

# --- OCR (optional; rules-engine PDF tooling only) ---------------------------
# Leave empty on Linux if `tesseract` is on PATH. Windows example:
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

TESSERACT_PATH=

# --- MedGemma (vision diagnosis — run separately, not via do_work.py) --------
# Backend workers use MEDGEMMA_GATEWAY_URL; the gateway uses REDIS_HOST/PORT.

MEDGEMMA_GATEWAY_URL=
MEDGEMMA_AUTH_HEADER=
MEDGEMMA_AUTH_VALUE=
MEDGEMMA_HTTP_TIMEOUT_S=
MEDGEMMA_HTTP_MAX_RETRIES=
MEDGEMMA_HTTP_RETRY_DELAY_MS=
MEDGEMMA_HTTP_RETRY_BACKOFF_MULTIPLIER=

REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=

# Modal / Hugging Face (MedGemma + Qwen deployment)
HF_TOKEN=

# MedGemma gateway tuning (optional overrides)
MEDGEMMA_JOB_STREAM=
MEDGEMMA_JOB_TTL_S=
MEDGEMMA_CONSUMER_GROUP=
MEDGEMMA_STREAM_MAXLEN=
MEDGEMMA_GLOBAL_RPM=
MEDGEMMA_GLOBAL_RL_WINDOW_S=
MEDGEMMA_GLOBAL_RL_KEY_PREFIX=
MAX_QUEUE_LEN_SOFT=
MAX_QUEUE_LEN_HARD=
API_WAIT_BUDGET_MS=
API_WAIT_STEP_MS=

# MedGemma Modal worker (optional overrides)
MEDGEMMA_STREAM_BATCH_SIZE=
MEDGEMMA_BATCH_WINDOW_S=
MEDGEMMA_STREAM_BLOCK_MS=
MEDGEMMA_MAX_INFLIGHT=
MEDGEMMA_CONSUMER_NAME=
MEDGEMMA_DLQ_STREAM=
MEDGEMMA_MAX_ATTEMPTS=

# MedGemma Modal app (optional overrides)
MEDGEMMA_ENGINE=
VLLM_BASE_URL=
VLLM_REQUEST_TIMEOUT_S=
VLLM_STARTUP_TIMEOUT_S=

# --- Diagnose worker ---------------------------------------------------------

DIAGNOSE_JOB_STREAM=
DIAGNOSE_CONSUMER_GROUP=
DIAGNOSE_CONSUMER_NAME=
DIAGNOSE_DLQ_STREAM=
DEFAULT_DIAGNOSE_PROMPT=
IMAGE_FETCH_TIMEOUT_S=
DIAGNOSE_CONFIDENCE_THRESHOLD=
PRODUCT_REVIEW_CONFIDENCE_THRESHOLD=

# --- Orchestrator worker streams (optional overrides) ------------------------

ORCHESTRATOR_JOB_STREAM=
ORCHESTRATOR_SIGNAL_STREAM=
ORCHESTRATOR_CONSUMER_GROUP=
ORCHESTRATOR_SIGNAL_CONSUMER_GROUP=
ORCHESTRATOR_CONSUMER_NAME=
ORCHESTRATOR_SIGNAL_CONSUMER_NAME=
ORCHESTRATOR_DLQ_STREAM=
ORCHESTRATOR_SIGNAL_DLQ_STREAM=
OUTBOUND_STREAM=
EVENTS_STREAM=
ESCALATION_STREAM=
JOB_MAX_INFLIGHT=
SIGNAL_MAX_INFLIGHT=
JOB_BATCH_MAX=
SIGNAL_BATCH_MAX=
JOB_BLOCK_MS=
SIGNAL_BLOCK_MS=
WORKERS_STREAM_MAXLEN=
WORKERS_STREAM_BLOCK_MS=
WORKERS_STREAM_BATCH_SIZE=
WORKERS_MAX_INFLIGHT=
WORKERS_JOB_TTL_S=

# --- Outbound sender (optional overrides) ------------------------------------

OUTBOUND_CONSUMER_GROUP=
OUTBOUND_CONSUMER_NAME=
OUTBOUND_DLQ_STREAM=
OUTBOUND_BATCH_MAX=
OUTBOUND_BLOCK_MS=
OUTBOUND_DEDUPE_TTL_SEC=
OUTBOUND_CONVO_FIRST_WINDOW_MS=
OUTBOUND_CHAOS_WINDOW_MS=
OUTBOUND_CHAOS_TTL_SEC=

# --- Escalation worker (not started by do_work.py) ---------------------------

ESCALATION_PLATFORM_URL=
QUTIS_INTERNAL_SECRET=
ESCALATION_DLQ_STREAM=
ESCALATION_CONSUMER_GROUP=
ESCALATION_CONSUMER_NAME=
ESCALATION_RELAY_MAX_ATTEMPTS=
ESCALATION_RELAY_BASE_DELAY_SEC=
