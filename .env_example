# ---------------------------------------------------------------------------
# BILLING (Paystack credits)
# ---------------------------------------------------------------------------
# Master switch. Off = no accounts, no top-up offers, webhook rejects traffic.
BILLING_ENABLED=false
# sk_test_... while testing, sk_live_... at shadow mode.
PAYSTACK_SECRET_KEY=
# Where Paystack returns the user after hosted checkout.
PAYSTACK_CALLBACK_URL=
# Webhook URL is configured in the Paystack dashboard (not an env var). Staging:
# https://<dermascan-api-staging>/v1/webhooks/paystack — never the workers URL.

# The webhook source-IP allowlist is not a setting: it is enforced whenever
# PAYSTACK_SECRET_KEY is a live key, and skipped for test keys so a local
# tunnel or curl replay can still reach the endpoint.

# Credit prices, token rates, the free-trial grant and the top-up minimum are
# NOT environment variables. They live in billing.price_list and are edited
# from the admin portal so a change does not need a deploy, and so a past
# charge stays explainable by the rate in force when it ran.

# --- Reminders (Postgres reminders schema; v1 dispatch: WhatsApp only) -------

# Master switch for scheduler/dispatch workers and tool mutations (default off).
REMINDERS_ENABLED=false
# IANA timezone for new users when not set in conversation (default Africa/Nairobi).
REMINDERS_DEFAULT_TIMEZONE=Africa/Nairobi
# Poll interval for due reminders (seconds).
REMINDER_TICK_INTERVAL_S=60
REMINDER_DUE_BATCH_SIZE=50
# Pending morning brief (missed 07:00 fire) delivers on next inbound only inside this local band.
REMINDERS_MORNING_DELIVERY_START_LOCAL=06:00
REMINDERS_MORNING_DELIVERY_END_LOCAL=12:00
