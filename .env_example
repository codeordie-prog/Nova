# --- Billing: metering and enforcement ---------------------------------------
# Credits are KES: one credit is one shilling.
#
# Prices, token rates, hold ceilings, the free-trial grant and usd_kes_rate are
# NOT environment variables. They live in billing.price_list and are edited from
# the admin portal, so a change needs no deploy and a past charge stays
# explainable by the rate that was in force when it ran.
#
# Only operational switches belong here.

# Record usage_line rows. Balance-neutral: safe to run on its own, and how the
# hold ceilings get sized from real traffic before anything is enforced.
BILLING_METER_ENABLED=false
# Place holds and turn a request away when credits run out.
# Requires BILLING_METER_ENABLED=true.
BILLING_ENFORCE=false
BILLING_SWEEP_INTERVAL_SEC=60
BILLING_SWEEP_BATCH_LIMIT=100
# Rate-card label stamped onto ledger and usage rows for audit.
BILLING_RATE_CARD_VERSION=2026-08-25
# Cloud SQL: reuse POSTGRES_* below (same qutis_db)

# --- Stream reclaim & per-client lock (liveness coordination) ----------------
# Keep reclaim idle STRICTLY GREATER than the client-lock lease so the reclaim
# loop never races a healthy long turn. The orchestrator job stream also emits
# an XCLAIM heartbeat (see ORCHESTRATOR_JOB_HEARTBEAT_INTERVAL_SEC) that resets
# a message's idle time while it is actively processing, so reclaim only fires
# for genuinely dead workers.
# Recommended: PENDING_MIN_IDLE_MS (>= 300000) > CLIENT_LOCK_LEASE_SEC (180).
WORKERS_STREAM_PENDING_MIN_IDLE_MS=300000
WORKERS_RECLAIM_INTERVAL_SEC=30
WORKERS_MAX_RECLAIM_ATTEMPTS=3
ORCHESTRATOR_CLIENT_LOCK_LEASE_SEC=180
ORCHESTRATOR_CLIENT_LOCK_WAIT_SEC=60
# Heartbeat cadence for in-flight job messages. Leave blank to auto-derive a
# safe value (~one third of the smaller of reclaim idle and lock lease).
ORCHESTRATOR_JOB_HEARTBEAT_INTERVAL_SEC=
ORCHESTRATOR_SIGNAL_HEARTBEAT_INTERVAL_SEC=

