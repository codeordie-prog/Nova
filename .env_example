# =============================================================================
# Dermascan Agents — environment variables
# Copy this file to `.env` at the repository root and fill in values.
# =============================================================================

# --- Core --------------------------------------------------------------------

REDIS_URL=
# Cap connections per pooled client (text + binary = 2 pools max via get_redis_client).
# Redis Cloud free/small tiers often allow ~30–256 clients TOTAL across all processes.
# Local dev: redis://127.0.0.1:6379/0 and keep this low (e.g. 16–32).
REDIS_MAX_CONNECTIONS=32
# When the per-process pool is full, wait for a slot instead of opening unbounded connections.
REDIS_POOL_BLOCKING=true
# Seconds to wait for a free pool slot (use none/forever to block until one is available).
REDIS_POOL_BLOCK_TIMEOUT_S=20

# Local test bot stack — when TEST_MODE=true, REDIS_URL points at the test instance
TEST_MODE=false
REDIS_TEST_USERNAME=default
REDIS_TEST_PASSWORD=
REDIS_TEST_HOST=
REDIS_TEST_PORT=
REDIS_TEST_URL=

# Optional: set on servers when the process cwd is not the repo root.
# Relative paths below are resolved against this directory (must contain pyproject.toml).
DERMASCAN_ROOT=

# --- Orchestrator LLM (ordered model chain with per-model circuit breakers) ---
# Comma-separated provider:model list; Gemini models are tried first, then OpenAI.
# Override model slugs if your account uses different names.
ORCHESTRATOR_MODEL_CHAIN=gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite,openai:gpt-4o,openai:gpt-5
# Skin/product report subagents (Layer 1 only; no gemini_degraded routing). OpenAI-first example matches ORCHESTRATOR_MODEL_CHAIN_ALT.
REPORT_MODEL_CHAIN=openai:gpt-4o-mini,openai:gpt-5-mini,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash
# Report subagent reliability (tool loops, recursion, parse failures)
REPORT_AGENT_RECURSION_LIMIT=8
REPORT_AGENT_INVOKE_MAX_RETRIES=3
REPORT_AGENT_INVOKE_RETRY_DELAY_S=2
REPORT_AGENT_TOOL_RUN_LIMIT=6
REPORT_AGENT_INCI_SEARCH_RUN_LIMIT=2
REPORT_AGENT_INTERNET_SEARCH_RUN_LIMIT=2
# Generic subagent invoke retries (used when REPORT_AGENT_* unset)
AGENT_INVOKE_MAX_RETRIES=3
AGENT_INVOKE_RETRY_DELAY_S=2
# Checkpoint summarization middleware: Gemini primary -> OpenAI fallback
SUMMARIZATION_MODEL_CHAIN=gemini:gemini-3.1-flash-lite,openai:gpt-4o-mini
# OpenAI-first alternate chains when Redis gemini_degraded is set (see model_chain_routing).
ORCHESTRATOR_MODEL_CHAIN_ALT=openai:gpt-4o-mini,openai:gpt-5-mini,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash
SUMMARIZATION_MODEL_CHAIN_ALT=openai:gpt-4o-mini,openai:gpt-5-mini,gemini:gemini-3.1-flash-lite
MODEL_CHAIN_GEMINI_ERROR_THRESHOLD=3
MODEL_CHAIN_GEMINI_ERROR_WINDOW_S=60
MODEL_CHAIN_GEMINI_DEGRADED_TTL_S=900
MODEL_CHAIN_TURN_STICKY_TTL_S=3600
# true = Gemini-first primary chain (normal). false/off = always use alternate (OpenAI-first) for testing.
MODEL_CHAIN_PREFER_PRIMARY=true
# Internal priority order for product/routine recommendations in reports (not shown to users).
PRODUCT_RECOMMENDATION_PRIORITY_BRANDS=La Roche-Posay,L'Oréal,Nivea,CeraVe
# Optional: outbound signal report size budgets (defaults: max 820, compact body 660, 3 bullets).
# SIGNAL_REPORT_MAX_CHARS=
# SIGNAL_REPORT_COMPACT_BODY_MAX_CHARS=
ORCHESTRATOR_GEMINI_THINKING_LEVEL=minimal
SUMMARIZATION_GEMINI_MODEL=gemini-3.1-flash-lite
SUMMARIZATION_MAX_TOKENS=1024
# Full-chain retry when every model in the chain fails (429/quota/timeout)
MODEL_CHAIN_MAX_RETRIES=2
MODEL_CHAIN_RETRY_DELAY_S=10
# Per-turn tool call caps (stops get_time / read_status polling loops)
ORCHESTRATOR_GET_TIME_RUN_LIMIT=1
ORCHESTRATOR_READ_STATUS_RUN_LIMIT=2
ORCHESTRATOR_TOOL_RUN_LIMIT=8
ORCHESTRATOR_AGENT_RECURSION_LIMIT=12
ORCHESTRATOR_RECURSION_MAX_RETRIES=5
ORCHESTRATOR_RECURSION_RETRY_DELAY_S=2
ORCHESTRATOR_RESET_CHECKPOINT_ON_RECURSION=true
# Disable OpenAI parallel tool calls (one tool call per step) to avoid orphaned
# tool_calls poisoning the checkpoint and to serialize intake session writes.
ORCHESTRATOR_DISABLE_PARALLEL_TOOL_CALLS=true
# Same policy for report/signal subagents (falls back to ORCHESTRATOR_DISABLE_PARALLEL_TOOL_CALLS).
AGENT_DISABLE_PARALLEL_TOOL_CALLS=
# Checkpoint restoration after a reset: re-inject a conversation recap so the
# session resumes instead of starting blind. Marker self-expires after TTL.
ORCHESTRATOR_CHECKPOINT_RESET_MARKER_TTL_SEC=900
ORCHESTRATOR_CONVERSATION_RECAP_AFTER_RESET_N=12
# Chat shortcuts (handled in worker before the agent): /wipe_memory, /menu (MYDAWA Turn menu)
ORCHESTRATOR_WIPE_MEMORY_COMMAND=/wipe_memory
ORCHESTRATOR_MYDAWA_MENU_COMMAND=/menu
ORCHESTRATOR_MYDAWA_MENU_REPLY=
ORCHESTRATOR_MYDAWA_MENU_FAIL_REPLY=
# Per-model circuit breaker (applies to each entry in ORCHESTRATOR_MODEL_CHAIN).
# Sliding-window breaker: trips only on provider-health errors (rate limits,
# timeouts, connection errors, 5xx) — request-shaped failures (recursion loops,
# structured-output/length/tool-protocol/context-length) never open the circuit.
# Trips when, within MODEL_CB_WINDOW_S: failures >= MODEL_CB_FAILURE_THRESHOLD,
# total requests >= MODEL_CB_MIN_VOLUME, and failure ratio >= MODEL_CB_FAILURE_RATIO.
MODEL_CB_FAILURE_THRESHOLD=3
MODEL_CB_WINDOW_S=30
MODEL_CB_COOLDOWN_S=20
MODEL_CB_COOLDOWN_JITTER_S=5
MODEL_CB_MIN_VOLUME=3
MODEL_CB_FAILURE_RATIO=0.5
# Legacy single-model env vars (ignored when ORCHESTRATOR_MODEL_CHAIN is set)
ORCHESTRATOR_OPENAI_MODEL=gpt-4o
ORCHESTRATOR_GEMINI_MODEL=gemini-3.5-flash
# Output token cap per model call (reasoning + visible text on Gemini 3.x).
ORCHESTRATOR_MAX_MODEL_LEN=128000
ORCHESTRATOR_MAX_TOKENS=2048
# gpt-5 / o-series: reasoning tokens count against max_tokens; raise budget + use minimal effort
OPENAI_REASONING_MAX_TOKENS=8192
OPENAI_REASONING_EFFORT=minimal
# Summarize checkpoint history before OpenAI TPM limits (default 24k; raise if tier increased)
ORCHESTRATOR_OPENAI_SUMMARIZATION_TRIGGER_TOKENS=24000

OPENAI_API_KEY_QUTIS=
OPENAI_REQUEST_TIMEOUT_S=
OPENAI_MAX_RETRIES=
OPENAI_CB_FAILURE_THRESHOLD=3
OPENAI_CB_COOLDOWN_S=20
# Per generateContent HTTP deadline (seconds); default 120 when unset.
GEMINI_REQUEST_TIMEOUT_S=45.0
# Google SDK retries; use 1 so model-chain fallback (next model) handles timeouts.
GEMINI_MAX_RETRIES=1
GEMINI_API_KEY_QUTIS=
GEMINI_CB_FAILURE_THRESHOLD=3
GEMINI_CB_COOLDOWN_S=20
# Repo-relative path (recommended) or absolute path on the host/container.
GOOGLE_APPLICATION_CREDENTIALS_QUTIS=dermascan/backend/services/agents/configurations/qutisai-01221e9627c1.json
GOOGLE_CLOUD_PROJECT_QUTIS=
# Gemini 3.x requires the global Vertex endpoint on many projects.
GOOGLE_CLOUD_LOCATION=global

