# --- WhatsApp (outbound + Turn sidecar) --------------------------------------
# Local: run sidecar manually, or use Cloud Run workers image (starts sidecar automatically).
#   poetry run uvicorn turn.scripts.turn_sidecar_adapter:app --host 127.0.0.1 --port 8000
# Workers container (deploy/scripts/run_workers_with_turn_sidecar.py):
#   WHATSAPP_SIDECAR_ENABLED=true  (default on when TURN_API_TOKEN is set)
#   WHATSAPP_SIDECAR_HOST=127.0.0.1
#   WHATSAPP_SIDECAR_PORT=8000
# Outbound worker → sidecar:
#   WHATSAPP_API_BASE_URL=http://127.0.0.1:8000
#   WHATSAPP_API_SEND_PATH=/send
#   WHATSAPP_API_TYPING_PATH=/typing
# Turn API (sandbox + prod same host; token selects account):
#   TURN_API_BASE_URL=https://whatsapp.turn.io
#   TURN_API_TOKEN=<Turn Settings → API & Webhooks>
#   TURN_WEBHOOK_SECRET=<Turn webhook signing secret; API verifies X-Turn-Hook-Signature>
#   TURN_MAIN_MENU_JOURNEY_UUID=<Main Menu stack uuid; ingress starts menu when active_handler != dermascan>
#   TURN_MYDAWA_MENU_EXIT_ENABLED=true  (orchestrator return_to_mydawa_main_menu tool)
# Inbound: point Turn webhook at API /v1/webhooks/whatsapp (not the sidecar on workers).

